# db_visualizer 2.2.0
# Copy this file to .env and replace every CHANGE_ME value before first start.

# PostgreSQL
POSTGRES_DB=db_visualizer
POSTGRES_USER=db_visualizer
POSTGRES_PASSWORD=

# Initial administrator. Used only when the users table is empty.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_FULL_NAME=Administrador
BOOTSTRAP_ADMIN_PASSWORD=

# Application
APP_PORT=8501
AUTH_SESSION_DAYS=7
AUTH_COOKIE_SECURE=false
SEARCH_RESULT_LIMIT=100
MIN_PASSWORD_LENGTH=12

# OCR
OCR_IMAGE=ghcr.io/huridocs/pdf-document-layout-analysis:latest
OCR_PULL_POLICY=missing
OCR_LANGUAGE=es
OCR_TIMEOUT_SECONDS=600
OCR_USE_FAST_MODE=false
OCR_ROTATE_PAGES=true
OCR_DESKEW=true
OCR_QUEUE_MAX_SIZE=20
OCR_WORKER_POLL_SECONDS=3
OCR_TEXT_EXTRACTION_MODE=local

# Production HTTPS (only required with compose.production.yml)
APP_DOMAIN=
